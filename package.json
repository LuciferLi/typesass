{
  "name": "codexman",
  "version": "0.0.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuciferLi/codexman.git"
  },
  "bugs": {
    "url": "https://github.com/LuciferLi/codexman/issues"
  },
  "homepage": "https://codexman.tolern.com/",
  "scripts": {
    "dev": "node scripts/freeDevPort.mjs 1420 && tauri dev",
    "dev:frontend": "node scripts/freeDevPort.mjs 1420 && vite --host 127.0.0.1",
    "tslint": "pnpm run typecheck",
    "lint": "eslint --ext .ts,.js,.vue --ignore-path .gitignore src/ && pnpm run typecheck",
    "lint:fix": "eslint --ext .ts,.js,.vue --fix --ignore-path .gitignore src/ && pnpm run typecheck",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "preview:web": "node scripts/devServer.mjs",
    "build:sidecar": "node scripts/buildSidecar.mjs",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@icon-park/svg": "^1.4.2",
    "@icon-park/vue-next": "^1.4.2",
    "@tauri-apps/api": "^2.11.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vueuse/core": "^14.4.0",
    "autoprefixer": "^10.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^2.3.1",
    "postcss": "^8.5.26",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "typescript": "^5.8.3",
    "unplugin-auto-import": "^21.1.0",
    "vite": "^7.0.6"
  }
}
